%version: 1.0

# - test suite?
# - Vector params (there will be many)
# - Vector state
# - Order (might be dictated somewhat by test suite)
#   - vset*
#   - integer arith (vadd/vsub/vrsub(.vv,.vx,.vi), compare, min, max)
#   - integer widening arith ()

# the vector register file is populated by the symtab from V.yaml

enum VectorLmulType {
  Divide
  Multiply
}

struct VectorState {
  Bits<7> sew;
  Bits<3> log2_sew;
  VectorLmulType lmul_type;
  Bits<2> log2_lmul;
}

function vector_state {
  returns VectorState
  description {
    Get the current vector state from CSRs
  }
  body {
    VectorState state;

    state.log2_sew = 3 + CSR[vtype].VSEW;
    state.sew = 7'b1 << state.log2_sew;

    Bits<3> vlmul = CSR[vtype].VLMUL;
    state.lmul_type = CSR[vtype].VLMUL[2] == 1'b1 ? VectorLmulType::Divide : VectorLmulType::Multiply;
    state.log2_lmul = CSR[vtype].VLMUL[1:0];
    if (vlmul == 3'b101) {
      state.log2_lmul = 3;
    } else if (vlmul == 3'b110) {
      state.log2_lmul = 2;
    } else if (vlmul == 3'b111) {
      state.log2_lmul = 1;
    } else if (vlmul == 3'b100) {
      unpredictable("VLMUL value 0b100 is reserved");
    }

    return state;
  }
}

function vreg_read_elem {
  returns Bits<64>
  arguments
    U32 eew,
    U32 index,
    Bits<5> base
  description {
    Return element +index+ of width +eew+ of the vector register group that
    starts at register +base+, zero-extended to 64 bits.

    With LMUL > 1, element +index+ is element (index mod VLEN/eew) of
    register base + index / (VLEN/eew).
  }
  body {
    U32 elems_per_reg = VLEN / eew;
    Bits<5> reg = base + (index / elems_per_reg);
    U32 lo = (index % elems_per_reg) * eew;
    return V[reg][lo + eew - 1:lo];
  }
}

function vreg_write_elem {
  arguments
    U32 eew,
    U32 index,
    Bits<5> base,
    Bits<64> value
  description {
    Write the low +eew+ bits of +value+ to element +index+ of the vector
    register group that starts at register +base+.

    With LMUL > 1, element +index+ is element (index mod VLEN/eew) of
    register base + index / (VLEN/eew).
  }
  body {
    U32 elems_per_reg = VLEN / eew;
    Bits<5> reg = base + (index / elems_per_reg);
    U32 lo = (index % elems_per_reg) * eew;
    V[reg][lo + eew - 1:lo] = value;
  }
}

function vreg_mask_active {
  returns Boolean
  arguments
    Bits<1> vm,
    U32 index
  description {
    Return true when element +index+ is active: the instruction is unmasked
    (+vm+ is 1), or bit +index+ of the mask register v0 is set.
  }
  body {
    return (vm == 1'b1) || (V[0][index] == 1'b1);
  }
}
