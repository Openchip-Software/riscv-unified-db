    }
    if ((w == 4) && (sew == 16) && (alt_a == 0) && (alt_b == 0) && (alt == 1) && (bs == 1)) {
      return implemented?(ExtensionName::Zvvxni4bf16mm);
    }
    if ((w == 4) && (sew == 32) && (alt_a == 0) && (alt_b == 0) && (alt == 0) && (bs == 0)) {
      return implemented?(ExtensionName::Zvvxi8fp32mm);
    }
    if ((w == 4) && (sew == 32) && (alt_a == 0) && (alt_b == 0) && (alt == 0) && (bs == 1)) {
      return implemented?(ExtensionName::Zvvxni8fp32mm);
    }
    if ((w == 8) && (sew == 32) && (alt_a == 0) && (alt_b == 0) && (alt == 0) && (bs == 0)) {
      return implemented?(ExtensionName::Zvvxi4fp32mm);
    }
    if ((w == 8) && (sew == 32) && (alt_a == 0) && (alt_b == 0) && (alt == 0) && (bs == 1)) {
      return implemented?(ExtensionName::Zvvxni4fp32mm);
    }
    if ((w == 8) && (sew == 64) && (alt_a == 0) && (alt_b == 0) && (alt == 0) && (bs == 0)) {
      return implemented?(ExtensionName::Zvvxi8fp64mm);
    }
    if ((w == 8) && (sew == 64) && (alt_a == 0) && (alt_b == 0) && (alt == 0) && (bs == 1)) {
      return implemented?(ExtensionName::Zvvxni8fp64mm);
    }
    return false;
  }
}

function zvvm_fp_grouping {
  returns U32
  arguments
    U32 sew,
    U32 w,
    Bits<3> lambda_enc
  description {
    Return the disclosed grouping factor G for (+sew+, +w+, lambda), where
    +lambda_enc+ is the nonzero vtype.LAMBDA encoding (specification
    `get_fp_grouping`).
  }
  body {
    if ((sew == 8) && (w == 1) && (implemented?(ExtensionName::Zvvofp8mm))) {
      return ZVVM_FP_GROUPING_SEW8_W1[lambda_enc - 1];
    }
    if ((sew == 8) && (w == 2) && (implemented?(ExtensionName::Zvvofp4ofp8mm))) {
      return ZVVM_FP_GROUPING_SEW8_W2[lambda_enc - 1];
    }
    if ((sew == 16) && (w == 1) && (implemented?(ExtensionName::Zvvfp16mm) || implemented?(ExtensionName::Zvvbf16mm))) {
      return ZVVM_FP_GROUPING_SEW16_W1[lambda_enc - 1];
    }
    if ((sew == 16) && (w == 2) && (implemented?(ExtensionName::Zvvofp8fp16mm) || implemented?(ExtensionName::Zvvofp8bf16mm))) {
      return ZVVM_FP_GROUPING_SEW16_W2[lambda_enc - 1];
    }
    if ((sew == 16) && (w == 4) && (implemented?(ExtensionName::Zvvofp4fp16mm) || implemented?(ExtensionName::Zvvofp4bf16mm))) {
      return ZVVM_FP_GROUPING_SEW16_W4[lambda_enc - 1];
    }
    if ((sew == 32) && (w == 1) && (implemented?(ExtensionName::Zvvfp32mm))) {
      return ZVVM_FP_GROUPING_SEW32_W1[lambda_enc - 1];
    }
    if ((sew == 32) && (w == 2) && (implemented?(ExtensionName::Zvvfp16fp32mm) || implemented?(ExtensionName::Zvvbf16fp32mm))) {
      return ZVVM_FP_GROUPING_SEW32_W2[lambda_enc - 1];
    }
    if ((sew == 32) && (w == 4) && (implemented?(ExtensionName::Zvvofp8fp32mm))) {
      return ZVVM_FP_GROUPING_SEW32_W4[lambda_enc - 1];
    }
    if ((sew == 32) && (w == 8) && (implemented?(ExtensionName::Zvvofp4fp32mm))) {
      return ZVVM_FP_GROUPING_SEW32_W8[lambda_enc - 1];
    }
    if ((sew == 64) && (w == 1) && (implemented?(ExtensionName::Zvvfp64mm))) {
      return ZVVM_FP_GROUPING_SEW64_W1[lambda_enc - 1];
    }
    if ((sew == 64) && (w == 2) && (implemented?(ExtensionName::Zvvfp32fp64mm))) {
      return ZVVM_FP_GROUPING_SEW64_W2[lambda_enc - 1];
    }
    if ((sew == 64) && (w == 4) && (implemented?(ExtensionName::Zvvfp16fp64mm) || implemented?(ExtensionName::Zvvbf16fp64mm))) {
      return ZVVM_FP_GROUPING_SEW64_W4[lambda_enc - 1];
    }
    if ((sew == 64) && (w == 8) && (implemented?(ExtensionName::Zvvofp8fp64mm))) {
      return ZVVM_FP_GROUPING_SEW64_W8[lambda_enc - 1];
    }
    return 0;
  }
}

function zvvm_fp_psm? {
  returns Boolean
  arguments
    U32 sew,
    U32 w,
    Bits<3> lambda_enc
  description {
    Return the disclosed partial-sum mode for (+sew+, +w+, lambda): false for
    psm=0 and true for psm=1 (specification `get_fp_psm`).
  }
  body {
    if ((sew == 8) && (w == 1) && (implemented?(ExtensionName::Zvvofp8mm))) {
      return ZVVM_FP_PSM_SEW8_W1[lambda_enc - 1];
    }
    if ((sew == 8) && (w == 2) && (implemented?(ExtensionName::Zvvofp4ofp8mm))) {
      return ZVVM_FP_PSM_SEW8_W2[lambda_enc - 1];
    }
    if ((sew == 16) && (w == 1) && (implemented?(ExtensionName::Zvvfp16mm) || implemented?(ExtensionName::Zvvbf16mm))) {
      return ZVVM_FP_PSM_SEW16_W1[lambda_enc - 1];
    }
    if ((sew == 16) && (w == 2) && (implemented?(ExtensionName::Zvvofp8fp16mm) || implemented?(ExtensionName::Zvvofp8bf16mm))) {
      return ZVVM_FP_PSM_SEW16_W2[lambda_enc - 1];
    }
    if ((sew == 16) && (w == 4) && (implemented?(ExtensionName::Zvvofp4fp16mm) || implemented?(ExtensionName::Zvvofp4bf16mm))) {
      return ZVVM_FP_PSM_SEW16_W4[lambda_enc - 1];
    }
    if ((sew == 32) && (w == 1) && (implemented?(ExtensionName::Zvvfp32mm))) {
      return ZVVM_FP_PSM_SEW32_W1[lambda_enc - 1];
    }
    if ((sew == 32) && (w == 2) && (implemented?(ExtensionName::Zvvfp16fp32mm) || implemented?(ExtensionName::Zvvbf16fp32mm))) {
      return ZVVM_FP_PSM_SEW32_W2[lambda_enc - 1];
    }
    if ((sew == 32) && (w == 4) && (implemented?(ExtensionName::Zvvofp8fp32mm))) {
      return ZVVM_FP_PSM_SEW32_W4[lambda_enc - 1];
    }
    if ((sew == 32) && (w == 8) && (implemented?(ExtensionName::Zvvofp4fp32mm))) {
      return ZVVM_FP_PSM_SEW32_W8[lambda_enc - 1];
    }
    if ((sew == 64) && (w == 1) && (implemented?(ExtensionName::Zvvfp64mm))) {
      return ZVVM_FP_PSM_SEW64_W1[lambda_enc - 1];
    }
    if ((sew == 64) && (w == 2) && (implemented?(ExtensionName::Zvvfp32fp64mm))) {
      return ZVVM_FP_PSM_SEW64_W2[lambda_enc - 1];
    }
    if ((sew == 64) && (w == 4) && (implemented?(ExtensionName::Zvvfp16fp64mm) || implemented?(ExtensionName::Zvvbf16fp64mm))) {
      return ZVVM_FP_PSM_SEW64_W4[lambda_enc - 1];
    }
    if ((sew == 64) && (w == 8) && (implemented?(ExtensionName::Zvvofp8fp64mm))) {
      return ZVVM_FP_PSM_SEW64_W8[lambda_enc - 1];
    }
    return false;
  }
}

function zvvm_fp_rnd {
  returns Bits<2>
  arguments
    U32 sew,
    U32 w,
    Bits<3> lambda_enc
  description {
    Return the disclosed group rounding for (+sew+, +w+, lambda): 0 for frm,
    1 for rto and 2 for xct (specification `get_fp_rnd`).
  }
  body {
    if ((sew == 8) && (w == 1) && (implemented?(ExtensionName::Zvvofp8mm))) {
      if (ZVVM_FP_RND_SEW8_W1[lambda_enc - 1] == "rto") {
        return 1;
      } else if (ZVVM_FP_RND_SEW8_W1[lambda_enc - 1] == "xct") {
        return 2;
      }
      return 0;
    }
    if ((sew == 8) && (w == 2) && (implemented?(ExtensionName::Zvvofp4ofp8mm))) {
      if (ZVVM_FP_RND_SEW8_W2[lambda_enc - 1] == "rto") {
        return 1;
      } else if (ZVVM_FP_RND_SEW8_W2[lambda_enc - 1] == "xct") {
        return 2;
      }
      return 0;
    }
    if ((sew == 16) && (w == 1) && (implemented?(ExtensionName::Zvvfp16mm) || implemented?(ExtensionName::Zvvbf16mm))) {
      if (ZVVM_FP_RND_SEW16_W1[lambda_enc - 1] == "rto") {
        return 1;
      } else if (ZVVM_FP_RND_SEW16_W1[lambda_enc - 1] == "xct") {
        return 2;
      }
      return 0;
    }
    if ((sew == 16) && (w == 2) && (implemented?(ExtensionName::Zvvofp8fp16mm) || implemented?(ExtensionName::Zvvofp8bf16mm))) {
      if (ZVVM_FP_RND_SEW16_W2[lambda_enc - 1] == "rto") {
        return 1;
      } else if (ZVVM_FP_RND_SEW16_W2[lambda_enc - 1] == "xct") {
        return 2;
      }
      return 0;
    }
    if ((sew == 16) && (w == 4) && (implemented?(ExtensionName::Zvvofp4fp16mm) || implemented?(ExtensionName::Zvvofp4bf16mm))) {
      if (ZVVM_FP_RND_SEW16_W4[lambda_enc - 1] == "rto") {
        return 1;
      } else if (ZVVM_FP_RND_SEW16_W4[lambda_enc - 1] == "xct") {
        return 2;
      }
      return 0;
    }
    if ((sew == 32) && (w == 1) && (implemented?(ExtensionName::Zvvfp32mm))) {
      if (ZVVM_FP_RND_SEW32_W1[lambda_enc - 1] == "rto") {
        return 1;
      } else if (ZVVM_FP_RND_SEW32_W1[lambda_enc - 1] == "xct") {
        return 2;
      }
      return 0;
    }
    if ((sew == 32) && (w == 2) && (implemented?(ExtensionName::Zvvfp16fp32mm) || implemented?(ExtensionName::Zvvbf16fp32mm))) {
      if (ZVVM_FP_RND_SEW32_W2[lambda_enc - 1] == "rto") {
        return 1;
      } else if (ZVVM_FP_RND_SEW32_W2[lambda_enc - 1] == "xct") {
        return 2;
      }
      return 0;
    }
    if ((sew == 32) && (w == 4) && (implemented?(ExtensionName::Zvvofp8fp32mm))) {
      if (ZVVM_FP_RND_SEW32_W4[lambda_enc - 1] == "rto") {
        return 1;
      } else if (ZVVM_FP_RND_SEW32_W4[lambda_enc - 1] == "xct") {
        return 2;
      }
      return 0;
    }
    if ((sew == 32) && (w == 8) && (implemented?(ExtensionName::Zvvofp4fp32mm))) {
      if (ZVVM_FP_RND_SEW32_W8[lambda_enc - 1] == "rto") {
        return 1;
      } else if (ZVVM_FP_RND_SEW32_W8[lambda_enc - 1] == "xct") {
        return 2;
      }
      return 0;
    }
    if ((sew == 64) && (w == 1) && (implemented?(ExtensionName::Zvvfp64mm))) {
      if (ZVVM_FP_RND_SEW64_W1[lambda_enc - 1] == "rto") {
        return 1;
      } else if (ZVVM_FP_RND_SEW64_W1[lambda_enc - 1] == "xct") {
        return 2;
      }
      return 0;
    }
    if ((sew == 64) && (w == 2) && (implemented?(ExtensionName::Zvvfp32fp64mm))) {
      if (ZVVM_FP_RND_SEW64_W2[lambda_enc - 1] == "rto") {
        return 1;
      } else if (ZVVM_FP_RND_SEW64_W2[lambda_enc - 1] == "xct") {
        return 2;
      }
      return 0;
    }
    if ((sew == 64) && (w == 4) && (implemented?(ExtensionName::Zvvfp16fp64mm) || implemented?(ExtensionName::Zvvbf16fp64mm))) {
      if (ZVVM_FP_RND_SEW64_W4[lambda_enc - 1] == "rto") {
        return 1;
      } else if (ZVVM_FP_RND_SEW64_W4[lambda_enc - 1] == "xct") {
        return 2;
      }
      return 0;
    }
    if ((sew == 64) && (w == 8) && (implemented?(ExtensionName::Zvvofp8fp64mm))) {
      if (ZVVM_FP_RND_SEW64_W8[lambda_enc - 1] == "rto") {
        return 1;
      } else if (ZVVM_FP_RND_SEW64_W8[lambda_enc - 1] == "xct") {
        return 2;
      }
      return 0;
    }
    return 0;
  }
}
