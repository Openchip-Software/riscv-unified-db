function zvvm_int_encoding_legal? {
  returns Boolean
  arguments
    U32 w,
    U32 sew
  description {
    Return true if the integer encoding map makes an ordinary (vm=1) integer
    multiply-accumulate with widening factor +w+ and SEW = +sew+ legal
    (specification `check_int_encoding_legality`). The row depends only on W
    and SEW, because altfmt_A and altfmt_B select signedness in every row.
  }
  body {
    if ((w == 1) && (sew == 8)) {
      return implemented?(ExtensionName::Zvvi8mm);
    }
    if ((w == 1) && (sew == 16)) {
      return implemented?(ExtensionName::Zvvi16mm);
    }
    if ((w == 1) && (sew == 32)) {
      return implemented?(ExtensionName::Zvvi32mm);
    }
    if ((w == 1) && (sew == 64)) {
      return implemented?(ExtensionName::Zvvi64mm);
    }
    if ((w == 2) && (sew == 8)) {
      return implemented?(ExtensionName::Zvvi4i8mm);
    }
    if ((w == 2) && (sew == 16)) {
      return implemented?(ExtensionName::Zvvi8i16mm);
    }
    if ((w == 2) && (sew == 32)) {
      return implemented?(ExtensionName::Zvvi16i32mm);
    }
    if ((w == 2) && (sew == 64)) {
      return implemented?(ExtensionName::Zvvi32i64mm);
    }
    if ((w == 4) && (sew == 16)) {
      return implemented?(ExtensionName::Zvvi4i16mm);
    }
    if ((w == 4) && (sew == 32)) {
      return implemented?(ExtensionName::Zvvi8i32mm);
    }
    if ((w == 4) && (sew == 64)) {
      return implemented?(ExtensionName::Zvvi16i64mm);
    }
    if ((w == 8) && (sew == 32)) {
      return implemented?(ExtensionName::Zvvi4i32mm);
    }
    if ((w == 8) && (sew == 64)) {
      return implemented?(ExtensionName::Zvvi8i64mm);
    }
    return false;
  }
}

